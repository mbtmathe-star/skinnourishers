# PayFast — set these as Vercel environment variables, never commit real values.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# sandbox | live — defaults to sandbox if unset
PAYFAST_MODE=sandbox

# Resend — used by /api/inquiry (consultation + skin assessment forms).
RESEND_API_KEY=
# Defaults to Resend's shared onboarding@resend.dev sender if unset (works
# immediately, no domain verification needed). Set to a verified sender on
# your own domain once you've added one in Resend.
RESEND_FROM_EMAIL=
# Defaults to info@skinnourishers.co.za if unset.
RESEND_TO_EMAIL=
