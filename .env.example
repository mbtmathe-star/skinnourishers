# PayFast — set these as Vercel environment variables, never commit real values.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# sandbox | live — defaults to sandbox if unset
PAYFAST_MODE=sandbox

# Resend — used by /api/inquiry (consultation + skin assessment forms) and by
# /api/payfast/notify (payment confirmation emails to the business + customer).
RESEND_API_KEY=
# Defaults to Resend's shared onboarding@resend.dev sender if unset (works
# immediately, no domain verification needed). Set to a verified sender on
# your own domain once you've added one in Resend.
RESEND_FROM_EMAIL=
# Defaults to info@skinnourishers.co.za if unset.
RESEND_TO_EMAIL=

# Supabase — used by /api/payfast/notify to persist a row in the `orders`
# table for every validated PayFast payment. Run supabase-schema.sql once in
# your project's SQL editor before setting these. Without them, payments are
# still processed correctly; they just aren't recorded anywhere durable
# (only as a log line in `vercel logs`).
# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> service_role key (NOT the anon/public key —
# this bypasses Row Level Security and must never be exposed client-side).
SUPABASE_SERVICE_ROLE_KEY=
