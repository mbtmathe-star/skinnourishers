# PayFast — set these as Vercel environment variables, never commit real values.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# sandbox | live — defaults to sandbox if unset
PAYFAST_MODE=sandbox

# Resend — used by /api/inquiry (consultation + skin assessment forms) and by
# /api/payfast/notify (payment confirmation emails to the business + customer).
RESEND_API_KEY=
# Defaults to Resend's shared onboarding@resend.dev sender if unset (works
# immediately, no domain verification needed). Set to a verified sender on
# your own domain once you've added one in Resend.
RESEND_FROM_EMAIL=
# Defaults to info@skinnourishers.co.za if unset.
RESEND_TO_EMAIL=

# Neon Postgres (via Vercel Marketplace) — used by /api/payfast/notify to
# persist a row in the `orders` table for every validated PayFast payment.
# Provisioned automatically: `vercel integration add neon -e production -e preview`
# adds DATABASE_URL (and several other Postgres/Neon vars) for you — nothing
# to set manually. schema.sql has already been run against production.
# Without it, payments still process correctly; they just aren't recorded
# anywhere durable (only as a log line in `vercel logs`).
DATABASE_URL=
